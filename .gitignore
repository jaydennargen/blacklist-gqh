# Sim / build outputs (regenerated by tools/run.py)
build/
work/
transcript
*.wlf
*.vstf
modelsim.ini
# Gowin outputs; the judged .fs is copied to bitstream/ by run.py synth.
# gowin/impl/gqh_process_config.json holds the project options (top module, SystemVerilog 2017) and IS committed.
gowin/impl/*
!gowin/impl/gqh_process_config.json
*.gprj.user
# Python
__pycache__/
*.pyc
# Generated vectors are reproducible from seed; commit only the ones a DECISION cites
vectors/*.hex
# Secrets never go in the repo (it becomes public at submission)
.env
*.key
